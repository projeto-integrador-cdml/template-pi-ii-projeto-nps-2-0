DISCORD_BOT_TOKEN="COLE_O_TOKEN_DO_SEU_BOT_DO_DISCORD_AQUI"
PORT=26653

# Conexão Aiven Cloud MySQL
MYSQL_HOST="projectes-projectes.l.aivencloud.com"
MYSQL_PORT="25241"
MYSQL_USER="avnadmin"
MYSQL_PASSWORD="sua_senha_aqui"
MYSQL_DATABASE="defaultdb"

# JWT (mesmo do CRM web)
JWT_SECRET="um_segredo_jwt_super_seguro_e_aleatorio"
DATABASE_URL="mysql://avnadmin:sua_senha_aqui@projectes-projectes.l.aivencloud.com:25241/defaultdb"

# Envio de E-mail (Gmail SMTP para Redefinição de Senha)
GMAIL_USER="seu_email@gmail.com"
GMAIL_PASS="sua_senha_de_app_de_16_digitos"

# Canais reais (configure aqui no servidor do bot)
NODE_ENV=production
PUBLIC_APP_URL=https://template-pi-ii-projeto-nps-2-0.vercel.app
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=
CHANNEL_ENCRYPTION_KEY=
# Gere duas chaves diferentes para os dois campos acima com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Preserve CHANNEL_ENCRYPTION_KEY junto ao backup do banco.

# O backend usa certs/cert.pem e certs/key.pem automaticamente.
# Para um proxy HTTPS privado da hospedagem (sem acesso HTTP público), opcional:
# API_TRUSTED_TLS_PROXY=true

# Comandos de dados no Discord ficam desativados até configurar ambos.
# Somente por mensagem privada, sem acesso global a outras empresas.
DISCORD_COMPANY_ID=
DISCORD_ALLOWED_USER_IDS=
