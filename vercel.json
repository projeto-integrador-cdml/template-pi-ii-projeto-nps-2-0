{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist/public",
  "functions": { "api/proxy.ts": { "maxDuration": 60 } },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/proxy?route=api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/proxy?route=uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
