# Configure no SERVIDOR que atende /api, não somente no frontend Vercel.
PUBLIC_APP_URL=https://template-pi-ii-projeto-nps-2-0.vercel.app
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
# Gere duas chaves diferentes com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_WEBHOOK_VERIFY_TOKEN=
CHANNEL_ENCRYPTION_KEY=
# Reutilize DATABASE_URL e JWT_SECRET existentes; não os substitua.
# Guarde CHANNEL_ENCRYPTION_KEY: trocar esta chave exige reconectar os canais.
